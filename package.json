{
  "name": "open-bridge",
  "version": "1.0.0-alpha.1",
  "description": "Standalone Streamable HTTP MCP bridge for local workspaces. \u5728\u672c\u673a\u5b89\u5168\u66b4\u9732\u5de5\u4f5c\u533a\u80fd\u529b\u7684\u72ec\u7acb MCP \u6865\u63a5\uff08CLI + Web \u63a7\u5236\u53f0\uff09\u3002",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ai-agent",
    "llm-tools",
    "developer-tools",
    "cli",
    "bridge"
  ],
  "author": "aoliaoduo <aoliaoduo@126.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aoliaoduo/open-bridge-app.git"
  },
  "homepage": "https://github.com/aoliaoduo/open-bridge-app#readme",
  "bugs": {
    "url": "https://github.com/aoliaoduo/open-bridge-app/issues"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "open-bridge": "bin/open-bridge.js"
  },
  "files": [
    "bin",
    "dist",
    "vendor",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/open-bridge.js serve --port 18080 --open",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && vite build",
    "build:core": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "lint": "eslint .",
    "test": "npm run test:core && npm run test:ui",
    "test:core": "tsx --test test/*.test.ts && node --test test/api-integration.test.mjs test/api-teardown-integration.test.mjs test/tunnel-integration.test.mjs",
    "test:ui": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run build && npm test",
    "start:local": "node bin/open-bridge.js serve --port 18080 --open --no-tunnel"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.4",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.0"
  }
}
