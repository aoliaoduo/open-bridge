{
  "name": "open-bridge",
  "version": "1.0.0",
  "description": "Standalone Streamable HTTP MCP bridge for local workspaces. 在本机安全暴露工作区能力的独立 MCP 桥接（CLI + Web 控制台）。",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ai-agent",
    "llm-tools",
    "developer-tools",
    "cli",
    "bridge"
  ],
  "author": "aoliaoduo <aoliaoduo@126.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aoliaoduo/open-bridge.git"
  },
  "homepage": "https://github.com/aoliaoduo/open-bridge#readme",
  "bugs": {
    "url": "https://github.com/aoliaoduo/open-bridge/issues"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "open-bridge": "bin/open-bridge.js"
  },
  "files": [
    "bin",
    "dist",
    "vendor",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "docs/configuration.md",
    "docs/tools.md",
    "CHANGELOG.md",
    "docs/ARCHITECTURE.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/open-bridge.js serve --port 18080",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && vite build",
    "build:core": "node scripts/clean.mjs core && tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "lint": "eslint .",
    "test": "npm run test:core && npm run test:ui",
    "test:core": "tsx --test test/*.test.ts && node --import ./test/setup-lang.mjs --test test/*.test.mjs",
    "test:ui": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run build && npm test",
    "package:check": "npm pack --dry-run --json --ignore-scripts | node scripts/package-check.mjs",
    "release:check": "npm run verify && npm run package:check",
    "audit": "npm audit --registry=https://registry.npmjs.org",
    "start:local": "node bin/open-bridge.js serve --port 18080 --no-tunnel"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server": "^2.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.20.0",
    "eslint": "^9.39.4",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.0"
  }
}
